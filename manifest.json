{
  "manifest_version": 3,
  "name": "Jenkins Dark Mode",
  "version": "1.0.0",
  "description": "Dark theme for the Jenkins web UI. Detects Jenkins pages automatically on any host.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Jenkins Dark Mode",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["dark.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
